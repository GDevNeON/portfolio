{
  "model_profile": "inherit",
  "commit_docs": true,
  "parallelization": false,
  "search_gitignored": false,
  "brave_search": false,
  "firecrawl": false,
  "exa_search": false,
  "tavily_search": false,
  "ref_search": false,
  "perplexity": false,
  "jina": false,
  "git": {
    "branching_strategy": "none",
    "create_tag": false,
    "phase_branch_template": "codex/{phase}-{slug}",
    "milestone_branch_template": "codex/{milestone}-{slug}",
    "quick_branch_template": "codex/quick-{slug}"
  },
  "workflow": {
    "research": false,
    "plan_check": true,
    "verifier": false,
    "nyquist_validation": false,
    "auto_advance": false,
    "node_repair": false,
    "node_repair_budget": 2,
    "ui_phase": true,
    "ui_safety_gate": true,
    "ai_integration_phase": false,
    "api_coverage_gate": true,
    "human_verify_mode": "end-of-phase",
    "context_guard_mode": "warn",
    "text_mode": false,
    "research_before_questions": false,
    "discuss_mode": "discuss",
    "skip_discuss": false,
    "code_review": false,
    "code_review_depth": "standard",
    "code_review_command": null,
    "pattern_mapper": false,
    "plan_bounce": false,
    "plan_bounce_script": null,
    "plan_bounce_passes": 2,
    "auto_prune_state": false,
    "post_planning_gaps": true,
    "security_enforcement": true,
    "security_asvs_level": 1,
    "security_block_on": "high",
    "_auto_chain_active": false
  },
  "ship": {
    "pr_body_sections": [
      {
        "heading": "User Stories & Acceptance Criteria",
        "enabled": false,
        "source": "REQUIREMENTS.md ## User Stories || REQUIREMENTS.md ## Acceptance Criteria"
      },
      {
        "heading": "Risks & Dependencies",
        "enabled": true,
        "source": "PLAN.md ## Risks || PLAN.md ## Dependencies",
        "fallback": "- See STATE.md and PROJECT.md for unresolved dependencies."
      },
      {
        "heading": "Success Metrics & Release Criteria",
        "enabled": true,
        "source": "REQUIREMENTS.md ## Definition of Done || VERIFICATION.md ## Release Criteria",
        "fallback": "- Release after required checks and owner review; retain missing evidence explicitly."
      },
      {
        "heading": "Stakeholder Review & Approval",
        "enabled": true,
        "template": "- Owner review status for {phase_name}: record reviewed and pending items."
      }
    ]
  },
  "hooks": {
    "context_warnings": true
  },
  "project_code": "NEON",
  "phase_naming": "sequential",
  "agent_skills": {},
  "claude_md_path": "./AGENTS.md",
  "plan_review": {
    "source_grounding": true,
    "source_grounding_authority": "grep"
  },
  "resolve_model_ids": "omit",
  "runtime": "codex",
  "response_language": "vi",
  "mode": "interactive",
  "granularity": "standard"
}
